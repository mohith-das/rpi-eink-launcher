[Unit]
Description=RPi E-Ink Touch Launcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/rpi-eink-launcher
ExecStart=/usr/bin/python3 /home/pi/rpi-eink-launcher/launcher.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
